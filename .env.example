# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The number to send FROM (Twilio number, US format e.g. +13055550100)
# For WhatsApp use: whatsapp:+14155238886 (Twilio sandbox) or your approved WA number
TWILIO_FROM_NUMBER=+13055550100

# Set to "whatsapp" or "sms"
OUTREACH_CHANNEL=sms

# Your name shown at the end of each message
YOUR_NAME=James

# Path to SQLite DB file
DB_PATH=roofers.db
