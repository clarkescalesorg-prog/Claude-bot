# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The number to send FROM (Twilio number, e.g. +441234567890)
# For WhatsApp use: whatsapp:+14155238886 (Twilio sandbox) or your approved WA number
TWILIO_FROM_NUMBER=+441234567890

# Set to "whatsapp" or "sms"
OUTREACH_CHANNEL=sms

# Your name shown at the end of each message
YOUR_NAME=James

# Path to SQLite DB file
DB_PATH=roofers.db

# --- Digital product storefront (product/server.py) ---
# Stripe API keys — fill in from https://dashboard.stripe.com/apikeys
# Test keys are prefixed sk_test_ ; live keys are prefixed sk_live_
STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_your_stripe_webhook_signing_secret

# Public URL the storefront is reachable at (used in Stripe redirects)
PUBLIC_BASE_URL=http://localhost:5000
